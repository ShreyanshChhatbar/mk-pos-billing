meta {
  name: Update Draft Invoice
  type: http
  seq: 2
}

put {
  url: {{base_url}}/api/v1/sales/sales-invoice/draft/{{draft_id}}
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{access_token}}
  device: {{device_token}}
  store: {{store_id}}
  Content-Type: application/json
}

body:json {
  {
    "billing_user_id": 1,
    "customer_id": 1,
    "patient_id": 1,
    "doctor_id": 1,
    "customer_address_id": null,
    "is_home_delivery": false,
    "is_confirmed": false,
    "promo_code": null,
    "course_days": null,
    "notes": "Updated draft invoice from Bruno",
    "asm_user_id": null,
    "items": [
      {
        "product_id": 1001,
        "batch_code": "BATCH123",
        "quantity": 1,
        "sales_rate": null,
        "is_free_product": false,
        "combo_product_id": null,
        "priceDelta": null,
        "best_alternate": {},
        "per_tab_frontend": null
      }
    ],
    "payments": [
      {
        "store_payment_method_id": 1,
        "amount": 100,
        "voucher_code": null,
        "is_advance_refund": false
      }
    ]
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Updates a default-organization sales invoice draft. Omit `items` completely to clear draft products; use payment `id` only for existing draft payments that should not be inserted again.
}
