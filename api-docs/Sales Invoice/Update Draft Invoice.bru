meta {
  name: Update Draft Invoice
  type: http
  seq: 2
}

put {
  url: {{base_url}}/api/v1/sales/sales-invoice/draft/{{draft_id}}
  body: json
  auth: bearer
}

headers {
  device: {{device_token}}
  store: {{store_id}}
  Content-Type: application/json
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
      "is_confirmed": true,
      "is_home_delivery": false,
      "billing_user_id": 859,
      "customer_id": 153,
      "customer_address_id": 267,
      "patient_id": 466,
      "doctor_id": 150,
      "items": [
          {
              "product_id": 21525,
              "batch_code": "23440101",
              "quantity": 2
          }
      ],
      "payments": [
        {
          "store_payment_method_id": 40,
          "amount": 298
        }
      ]
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: false
  maxRedirects: 5
}

docs {
  Updates a default-organization sales invoice draft. Omit `items` completely to clear draft products; use payment `id` only for existing draft payments that should not be inserted again.
}
