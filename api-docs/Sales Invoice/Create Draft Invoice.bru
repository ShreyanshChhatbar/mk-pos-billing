meta {
  name: Create Draft Invoice
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/v1/sales/sales-invoice/draft/create
  body: json
  auth: bearer
}

headers {
  device: {{device_token}}
  store: {{store_id}}
  Content-Type: application/json
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
      "is_confirmed": false,
      "is_home_delivery": false,
      "billing_user_id": 859,
      "customer_id": 153,
      "customer_address_id": 267,
      "patient_id": 466,
      "doctor_id": 150,
      "items": [
          {
              "product_id": 11384,
              "batch_code": "WEIY89",
              "quantity": 1
          }
      ]
  }
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: false
  maxRedirects: 5
}

docs {
  Creates a default-organization sales invoice draft. Context fields are taken from POS middleware headers/cache, not from the request body.
}
