meta {
  name: Create Draft Invoice
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/v1/sales/sales-invoice/draft/create
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{access_token}}
  device: {{device_token}}
  store: {{store_id}}
  Content-Type: application/json
}

body:json {
  {
    "billing_user_id": 1,
    "customer_id": null,
    "patient_id": null,
    "doctor_id": null,
    "customer_address_id": null,
    "is_home_delivery": false,
    "is_confirmed": false,
    "promo_code": null,
    "course_days": null,
    "notes": "Draft invoice from Bruno",
    "asm_user_id": null,
    "items": [
      {
        "product_id": 1001,
        "batch_code": "BATCH123",
        "quantity": 1,
        "sales_rate": null,
        "is_free_product": false,
        "combo_product_id": null,
        "priceDelta": null,
        "best_alternate": {},
        "per_tab_frontend": null
      }
    ],
    "payments": []
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Creates a default-organization sales invoice draft. Context fields are taken from POS middleware headers/cache, not from the request body.
}
