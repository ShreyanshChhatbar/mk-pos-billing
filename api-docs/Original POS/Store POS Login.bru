meta {
  name: Store POS Login
  type: http
  seq: 2
}

post {
  url: {{auth_pos_url}}/store-pos/login
  body: json
  auth: none
}

headers {
  device: {{device_token}}
  store: {{store_id}}
}

body:json {
  {
      "mobile_number" : "9316909534",
      "password": "12345678"
  }
}

script:post-response {
  const data = res.getBody();
  if (data && data.data && data.data.auth_token) {
    bru.setVar("access_token", data.data.auth_token);
  }
}
